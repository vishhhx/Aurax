generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  assetId String @id @default(cuid())
  symbol String @unique
  imageUrl String
  name String
  decimals Int
  network String?

  depositEnabled Boolean @default(true)
  withdrawalEnabled Boolean @default(true)

  minDeposit Decimal @db.Decimal(30, 8)
  minWithdrawal Decimal @db.Decimal(30, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits Deposit[]
  wallets Wallet[]
  walletTransactions WalletTransaction[]
  ledgers Ledger[]

  baseMarkets Market[] @relation("BaseAsset")
  quoteMarkets Market[] @relation("QuoteAsset")
  balanceReservations BalanceReservation[]
}

model Deposit {
  depositId String @id @default(cuid())

  userId String

  assetId String
  asset Asset @relation(fields: [assetId], references: [assetId])

  amount Decimal @db.Decimal(30, 8)

  orderId String? @unique
  paymentId String? @unique

  txHash String? @unique
  network String?
  confirmations Int @default(0)

  status DepositStatus @default(PENDING)

  createdAt DateTime @default(now())
  completedAt DateTime?
}

model Wallet {
  walletId String @id @default(cuid())

  userId String

  assetId String
  asset Asset @relation(fields: [assetId], references: [assetId])

  availableBalance Decimal @default(0) @db.Decimal(30, 8)
  lockedBalance Decimal @default(0) @db.Decimal(30, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, assetId])
}

model WalletTransaction {
  walletTransactionId String @id @default(cuid())

  userId String

  assetId String
  asset Asset @relation(fields: [assetId], references: [assetId])

  amount Decimal @db.Decimal(30, 8)

  type WalletTransactionType
  status WalletTransactionStatus

  referenceId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([assetId])
  @@index([referenceId])
}

model Ledger {
  ledgerId String @id @default(cuid())

  userId String

  assetId String
  asset Asset @relation(fields: [assetId], references: [assetId])

  entryType LedgerEntryType
  amount Decimal @db.Decimal(30, 8)

  referenceId String
  referenceType LedgerReferenceType

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([assetId])
  @@index([referenceId])
}

model Market {
  marketId String @id @default(cuid())

  symbol String @unique

  baseAssetId String
  quoteAssetId String

  baseAsset Asset @relation("BaseAsset", fields: [baseAssetId], references: [assetId])
  quoteAsset Asset @relation("QuoteAsset", fields: [quoteAssetId], references: [assetId])

  status MarketStatus @default(TRADING)

  tickSize Decimal @db.Decimal(30, 18)
  stepSize Decimal @db.Decimal(30, 18)

  minPrice Decimal @db.Decimal(30, 18)
  maxPrice Decimal @db.Decimal(30, 18)

  minQuantity Decimal @db.Decimal(30, 18)
  maxQuantity Decimal @db.Decimal(30, 18)

  minNotional Decimal @db.Decimal(30, 18)

  makerFee Decimal @db.Decimal(10, 8)
  takerFee Decimal @db.Decimal(10, 8)

  pricePrecision Int
  quantityPrecision Int

  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  trades Trade[]

  @@index([baseAssetId])
  @@index([quoteAssetId])
}

model Order {
  orderId String @id @default(cuid())

  userId String

  marketId String
  market Market @relation(fields: [marketId], references: [marketId])

  symbol String

  side OrderSide
  orderType OrderType

  quantity Decimal @db.Decimal(30, 18)
  price Decimal? @db.Decimal(30, 18)

  executedQuantity Decimal @default(0) @db.Decimal(30, 18)
  remainingQuantity Decimal @db.Decimal(30, 18)

  averagePrice Decimal? @db.Decimal(30, 18)

  timeInForce TimeInForce @default(GTC)

  status OrderStatus @default(PENDING)


  referenceId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades Trade[]


  @@index([userId])
  @@index([marketId])
  @@index([symbol])
  @@index([userId, status])
  @@index([marketId, status])
}

model Trade {
  tradeId String @id @default(cuid())

  orderId String
  order Order @relation(fields: [orderId], references: [orderId])

  userId String

  marketId String
  market Market @relation(fields: [marketId], references: [marketId])

  symbol String

  side OrderSide

  price Decimal @db.Decimal(30, 18)
  quantity Decimal @db.Decimal(30, 18)

  quoteAmount Decimal @db.Decimal(30, 18)

  fee Decimal @default(0) @db.Decimal(30, 18)
  feeAsset String

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([marketId])
  @@index([symbol])
}



model BalanceReservation {
  id              String            @id @default(uuid())
  referenceId     String            @unique
  userId          String
  assetId         String
  amount          Decimal           @db.Decimal(30, 8)
  remainingAmount Decimal           @db.Decimal(30, 8)
  status          ReservationStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  asset Asset @relation(fields: [assetId], references: [assetId])

  @@index([userId])
  @@index([userId, assetId])
}


enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  CANCELLED
}


enum MarketStatus {
  TRADING
  HALTED
  MAINTENANCE
  CANCEL_ONLY
  POST_ONLY
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum TimeInForce {
  GTC
  IOC
  FOK
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum DepositStatus {
  PENDING
  CONFIRMING
  COMPLETED
  FAILED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerReferenceType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  FEE
  ADJUSTMENT
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAW
  TRADE
  AIRDROP
  REFERRAL
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}