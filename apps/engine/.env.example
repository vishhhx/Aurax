PG_DATABASE_URL=postgresql://aurax:auraxpassword@localhost:5432/aurax-v1
KAFKA_BROKERS=localhost:9092
# One shard process per list; shard i serves gRPC on ENGINE_GRPC_BASE_PORT + i
MARKETS_A=BTCUSDC,ETHUSDC
MARKETS_B=SOLUSDC,USDTUSDC
ENGINE_GRPC_HOST=0.0.0.0
ENGINE_GRPC_BASE_PORT=8003
# s3 (default when S3_BUCKET_NAME is set) or fs
SNAPSHOT_STORE=s3
SNAPSHOT_DIR=.snapshots
SNAPSHOT_EVERY=100
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
