# api-gateway origin; every REST call goes to ${NEXT_PUBLIC_API_URL}/api/v1/...
NEXT_PUBLIC_API_URL=http://localhost:5000
# websockets (socket.io) origin
NEXT_PUBLIC_SOCKET_URL=http://localhost:5005
# Razorpay key id (public). Must belong to the same account as wallet-service's
# RAZORPAY_CLIENT_ID. When unset, the deposit page reports deposits as not configured.
NEXT_PUBLIC_RAZORPAY_KEY=
