PORT=5001
NODE_ENV=development

# MongoDB (users)
DATABASE_URL=mongodb://localhost:27017/aurax

# Redis (refresh sessions, OAuth state, user-details cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Must match every service that verifies tokens (gateway, wallet, order, websockets)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Browser lands here after OAuth: <FRONTEND_URL>/auth/success or /login?error=auth_failed
FRONTEND_URL=http://localhost:3000

# OAuth apps. Redirect URIs go through the API gateway.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/oauth2/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/v1/auth/oauth2/github/callback
