PORT=5005
NODE_ENV=development

# Same secret auth-service signs access tokens with
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Shared infrastructure (defaults shown)
KAFKA_BROKERS=localhost:9092

# Direct market-service URL (not the API gateway): depth resync snapshots and
# the tradable-symbol list. Optional; without it resync waits for the periodic
# Kafka snapshot and symbols are validated by format only.
MARKET_SERVICE_URL=http://localhost:5004

CORS_ORIGINS=http://localhost:3000

# Must be unique per running instance (per-instance Kafka consumer groups).
# Defaults to <hostname>-<pid>.
# INSTANCE_ID=
KAFKA_GROUP_PREFIX=websockets

MAX_SUBSCRIPTIONS_PER_SOCKET=50
TICKER_COALESCE_MS=250
SLOW_CLIENT_BUFFER_LIMIT=1000
